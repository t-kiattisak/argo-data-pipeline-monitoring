# Application Settings
SERVICE_NAME=batch-data-extractor
EXPORT_DATE=2026-09-17

# Storage Backend: 'local' (บันทึกเป็นไฟล์ในเครื่อง) หรือ 'minio' (S3 จำลองใน Docker)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=postgrespassword

# MinIO (ใช้เมื่อ STORAGE_BACKEND=minio)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=data-lake-bucket
PRESIGNED_URL_EXPIRY_SECONDS=7200

# Downstream Webhook (ตั้ง False ไว้หากทดสอบเฉพาะ Extraction)
ENABLE_WEBHOOK=false
API_GATEWAY_WEBHOOK_URL=http://localhost:8000/events/v1/batch-completed
JWT_SECRET_KEY=demo-secret-key
JWT_ALGORITHM=HS256
